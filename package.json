{
  "name": "periodical-archiver",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Windows-first personal archiver for Caixin Weekly and Lifeweek with EPUB, PDF, TXT, cover, and summary output.",
  "main": "src/fetch_issue.js",
  "scripts": {
    "fetch": "node src/cli.js fetch",
    "fetch:lifeweek": "node src/cli.js fetch --publication lifeweek",
    "build:epub": "node src/cli.js build:epub",
    "build:pdf": "node src/cli.js build:pdf",
    "build:txt": "node src/cli.js build:txt",
    "build:summary": "node src/cli.js build:summary",
    "build:summary:all": "node src/cli.js build:summary --all",
    "publish": "node src/cli.js publish",
    "archive": "node src/cli.js archive",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "playwright": "^1.54.2"
  }
}
